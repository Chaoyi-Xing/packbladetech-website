<section class="hero <%= theme.hero_image ? 'hero--with-image' : 'hero--no-image' %>" aria-labelledby="hero-title">
  <div class="shell hero-layout">
    <div class="hero-copy">
      <div class="hero-heading"><h1 id="hero-title">Packaging Machine Knives</h1></div>
      <div class="hero-details">
        <p>Replacement and custom cutting blades for packaging machinery, manufactured in China.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/products/">Explore Products <span aria-hidden="true">→</span></a>
          <a class="button button-secondary" href="mailto:sales@packbladetech.com">Email for a Quote <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
    <% if (theme.hero_image) { %>
      <div class="hero-media"><img src="<%- url_for(theme.hero_image) %>" alt="<%= theme.hero_image_alt || 'Packaging machine knife' %>"></div>
    <% } %>
  </div>
</section>

<section class="home-section product-section shell" aria-labelledby="categories-title">
  <div class="section-heading">
    <div>
      <p class="section-label">Product categories</p>
      <h2 id="categories-title">Knives for every part of the packaging line.</h2>
    </div>
    <p>Explore five focused product families for packaging, bag making and film converting.</p>
  </div>
  <%
    const categories = [
      ['serrated-packaging-knives', 'Serrated Packaging Knives'],
      ['flow-wrapper-knives', 'Flow Wrapper Knives'],
      ['bag-making-sealing-knives', 'Bag Making & Sealing Knives'],
      ['sachet-cutting-knives', 'Sachet Cutting Knives'],
      ['film-cutting-slitting-knives', 'Film Cutting & Slitting Knives']
    ];
  %>
  <div class="home-category-grid">
    <% categories.forEach(([slug, title], index) => { const photo = theme.category_images && theme.category_images[slug]; %>
      <a class="home-category-card" href="/products/<%= slug %>/">
        <% if (photo) { %><span class="category-media"><img src="<%- url_for(photo) %>" alt=""></span><% } %>
        <span class="category-info"><span class="category-number"><%= String(index + 1).padStart(2, '0') %></span><span class="category-title"><%= title %></span><span class="category-arrow" aria-hidden="true">→</span></span>
      </a>
    <% }); %>
  </div>
  <a class="section-link" href="/products/">Explore all products <span aria-hidden="true">→</span></a>
</section>

<section class="home-section replacement-section" aria-labelledby="replacement-title">
  <div class="shell editorial-grid">
    <div>
      <p class="section-label">Aftermarket replacement knives</p>
      <h2 id="replacement-title">The right replacement starts with the right details.</h2>
    </div>
    <div class="editorial-body">
      <p>For packaging machines already in service, we can review your existing blade reference, dimensions and cutting application.</p>
      <p>Share the machine model, part number or sample details, along with the quantity you need.</p>
      <a class="section-link" href="/products/">Explore replacement knives <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<section class="home-section custom-section" aria-labelledby="custom-title">
  <div class="shell editorial-grid">
    <div>
      <p class="section-label">Custom knives</p>
      <h2 id="custom-title">Your drawing is a good place to begin.</h2>
    </div>
    <div class="editorial-body">
      <p>For a knife outside the standard range, send a drawing or clear sample reference. Include the material being cut, the machine and the required quantity.</p>
      <a class="section-link" href="/custom-knives/">How custom enquiries work <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<section class="home-section guides-section shell" aria-labelledby="guides-title">
  <div class="section-heading">
    <div>
      <p class="section-label">Technical guides</p>
      <h2 id="guides-title">Practical knowledge for a better blade enquiry.</h2>
    </div>
    <p>Clear guidance for identifying, measuring and selecting replacement knives.</p>
  </div>
  <div class="guide-list">
    <a href="/guides/identify-measure-packaging-machine-knives/"><span class="guide-number">01</span><span>How to Identify and Measure Packaging Machine Knives</span><span class="guide-arrow" aria-hidden="true">→</span></a>
    <a href="/guides/serrated-vs-straight-packaging-knives/"><span class="guide-number">02</span><span>Serrated vs Straight Packaging Knives</span><span class="guide-arrow" aria-hidden="true">→</span></a>
    <a href="/guides/select-flow-wrapping-replacement-knives/"><span class="guide-number">03</span><span>Selecting Flow-Wrapper Replacement Knives</span><span class="guide-arrow" aria-hidden="true">→</span></a>
  </div>
  <a class="section-link" href="/guides/">View all technical guides <span aria-hidden="true">→</span></a>
</section>

<section class="home-section rfq-section" aria-labelledby="contact-title">
  <div class="shell rfq-grid">
    <div>
      <p class="section-label">Contact / RFQ</p>
      <h2 id="contact-title">Let’s talk about your next cutting requirement.</h2>
    </div>
    <div class="rfq-body">
      <p>Send your drawing, part reference or blade details, along with the quantity. We’ll review your enquiry and follow up by email.</p>
      <a class="button button-primary" href="mailto:sales@packbladetech.com">Email for a Quote <span aria-hidden="true">→</span></a>
      <a class="rfq-email" href="mailto:sales@packbladetech.com">sales@packbladetech.com</a>
    </div>
  </div>
</section>
