<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href="/" aria-label="PackBlade Tech home">PackBlade <span>Tech</span></a>
    <nav class="site-nav" aria-label="Main navigation">
      <% for (const [label, href] of Object.entries(theme.menu)) { %>
        <a href="<%= href %>"<% if (page.path === 'index.html' && href === '/') { %> aria-current="page"<% } else if (page.path !== 'index.html' && href !== '/' && ('/' + page.path).startsWith(href)) { %> aria-current="page"<% } %>><%= label %></a>
      <% } %>
    </nav>
  </div>
</header>
