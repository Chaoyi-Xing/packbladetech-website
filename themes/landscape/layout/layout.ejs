<!doctype html>
<html lang="en">
<%
  // Relative asset and navigation URLs work on both the project preview path
  // and the eventual custom-domain root without a separate build.
  const prefix = '../'.repeat((String(page.path || 'index.html').match(/\//g) || []).length);
  const localLinks = html => String(html).replace(/\b(href|src)="\/(?!\/)/g, '$1="' + prefix);
%>
<%- localLinks(partial('_partial/head')) %>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <%- localLinks(partial('_partial/header')) %>
  <main id="main-content"><%- localLinks(body) %></main>
  <%- localLinks(partial('_partial/footer')) %>
</body>
</html>
